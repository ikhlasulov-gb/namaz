<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.ikhlasulov_gb.Namaz</id>
  <name>Namaz</name>
  <summary>Muslim prayer times, Qibla and Hijri calendar</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <description>
    <p>
      Namaz is a native Linux application for the five daily prayers. It
      calculates prayer times from your location and chosen calculation
      method, shows the Qibla direction and a Hijri calendar, and can play
      the adhan, reminders and iqama from the system tray.
    </p>
    <p>
      The interface follows the KDE Plasma human interface guidelines and
      integrates with the desktop through XDG autostart, a D-Bus API, desktop
      notifications and the KDE screen locker.
    </p>
    <ul>
      <li>Day, month and year prayer-time views</li>
      <li>Qibla compass and Hijri calendar</li>
      <li>Tray icon, reminders, iqama and custom audio</li>
      <li>Multiple calculation methods and high-latitude rules</li>
      <li>PDF and CSV export, including Outlook CSV</li>
    </ul>
  </description>

